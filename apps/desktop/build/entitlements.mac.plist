<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's renderer compiles JavaScript at runtime, which the hardened runtime
         forbids by default. Notarization requires the hardened runtime, so both of these
         are mandatory rather than optional hardening relaxations. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Loading the packaged Electron framework and any unsigned dylib it ships. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The app talks to the local control server and to Tilde over HTTPS. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
