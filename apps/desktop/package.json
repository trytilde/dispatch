{
  "name": "@openbot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenBot desktop client",
  "license": "MIT",
  "author": {
    "name": "OpenBot contributors",
    "email": "opensource@trytilde.ai"
  },
  "repository": "https://github.com/trytilde/openbot",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsgo --noEmit && tsdown",
    "dev": "vp run build && electron .",
    "lint": "vp lint",
    "package": "vp run --filter @openbot/web build && vp run build && node scripts/package-current.mjs",
    "package:linux": "vp run --filter @openbot/web build && vp run build && electron-builder --linux",
    "package:mac": "vp run --filter @openbot/web build && vp run build && electron-builder --mac",
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "build": {
    "appId": "dev.openbot.desktop",
    "productName": "OpenBot",
    "executableName": "openbot",
    "icon": "build/icon.png",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "desktopName": "OpenBot.desktop"
}
