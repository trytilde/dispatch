{
  "expo": {
    "name": "OpenBot",
    "slug": "openbot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openbot",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.openbot.mobile"
    },
    "android": {
      "package": "dev.openbot.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#f5f5f2"
      }
    },
    "plugins": ["expo-secure-store", "expo-image"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
