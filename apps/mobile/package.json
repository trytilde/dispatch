{
  "name": "@tryopenbot/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "android": "node scripts/expo.mjs run:android",
    "build": "node scripts/expo.mjs export --platform all --output-dir dist",
    "check": "vp check",
    "dev": "node scripts/expo.mjs start --dev-client --clear",
    "emulator": "node scripts/android-emulator.mjs",
    "ios": "node scripts/expo.mjs run:ios",
    "start": "node scripts/expo.mjs start",
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tryopenbot/client-runtime": "workspace:*",
    "expo": "~57.0.14",
    "expo-auth-session": "~57.0.7",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
