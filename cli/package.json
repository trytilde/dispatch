    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.1",
    "@openbot/server": "workspace:*",
    "arg": "5.0.2",
    "dotenv": "17.2.1",
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
