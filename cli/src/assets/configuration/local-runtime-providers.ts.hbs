import { TildeAgentProvider } from "@tryopenbot/agent-provider";
import { RuntimeProviders } from "@tryopenbot/configuration";
import { MicrosandboxComputerProvider } from "@tryopenbot/computer-provider";
import { OpenAIApiKeyInferenceModelProvider } from "@tryopenbot/inference-model-provider";
import { TildePlatform } from "@tryopenbot/platform-integrations";
import { TildeSkillProvider } from "@tryopenbot/skills-provider";
import { TildeToolProvider } from "@tryopenbot/tools-provider";

function requiredEnvironment(name: string): string {
  const value = process.env[name]?.trim();
  if (!value) throw new Error(`${name} is required`);
  return value;
}

const tilde = new TildePlatform({
  apiKey: requiredEnvironment("TILDE_API_KEY"),
  baseUrl: process.env.TILDE_BASE_URL ?? "https://api.trytilde.ai",
  orgId: requiredEnvironment("TILDE_ORG_ID"),
  teamId: requiredEnvironment("TILDE_TEAM_ID"),
});

export default RuntimeProviders({
  agent: new TildeAgentProvider(tilde),
  computer: new MicrosandboxComputerProvider(),
  inferenceModel: new OpenAIApiKeyInferenceModelProvider({ apiKey: requiredEnvironment("OPENAI_API_KEY") }),
  skills: new TildeSkillProvider(tilde),
  tools: new TildeToolProvider({ platform: tilde, serverId: requiredEnvironment("TILDE_RUNTIME_MCP_SERVER_ID") }),
});
