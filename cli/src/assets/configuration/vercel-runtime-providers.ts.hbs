import { TildeAgentProvider } from "@tryopenbot/agent-provider";
import { RuntimeProviders } from "@tryopenbot/configuration";
import { VercelSandboxComputerProvider } from "@tryopenbot/computer-provider";
import { OpenAIApiKeyInferenceModelProvider } from "@tryopenbot/inference-model-provider";
import { TildeSkillProvider } from "@tryopenbot/skills-provider";
import { TildeToolProvider } from "@tryopenbot/tools-provider";
import { createClient } from "@trytilde/harness-sdk";

function requiredEnvironment(name: string): string {
  const value = process.env[name]?.trim();
  if (!value) throw new Error(`${name} is required`);
  return value;
}

const tilde = {
  apiKey: requiredEnvironment("OPENBOT_TILDE_API_KEY"),
  baseUrl: process.env.TILDE_BASE_URL ?? "https://api.trytilde.ai",
  orgId: requiredEnvironment("OPENBOT_TILDE_ORG_ID"),
  teamId: requiredEnvironment("OPENBOT_TILDE_TEAM_ID"),
};
const tildeClient = createClient({ ...tilde, orgSubdomain: false });

export default RuntimeProviders({
  agent: new TildeAgentProvider(tilde),
  computer: new VercelSandboxComputerProvider(),
  inferenceModel: new OpenAIApiKeyInferenceModelProvider({ apiKey: requiredEnvironment("OPENBOT_OPENAI_API_KEY") }),
  skills: new TildeSkillProvider(tilde),
  tools: new TildeToolProvider({ client: tildeClient, serverId: requiredEnvironment("OPENBOT_TILDE_RUNTIME_MCP_SERVER_ID") }),
});
