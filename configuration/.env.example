# Public endpoint; provider selection lives in configuration/index.ts.
OPENBOT_PUBLIC_ORIGIN=

# Model provider
OPENAI_MODEL=gpt-5.4

# Tilde resource identifiers
TILDE_ORG_ID=
TILDE_TEAM_ID=

# Vercel service projects
OPENBOT_VERCEL_CONTROL_PROJECT=
OPENBOT_VERCEL_AGENT_PROJECT=
VERCEL_TEAM_ID=

# Untagged OCI repository used by the selected computer provider lifecycle
OPENBOT_COMPUTER_IMAGE_REPOSITORY=

# API keys and tokens belong in configuration/secrets.enc.yaml.
# Run `pnpm openbot init` instead of putting them in this file.
