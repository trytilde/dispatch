{
  "name": "openbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "XDG_CACHE_HOME=.cache vp run contracts:generate && XDG_CACHE_HOME=.cache vp run -r build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check": "XDG_CACHE_HOME=.cache vp run contracts:generate && XDG_CACHE_HOME=.cache vp check && XDG_CACHE_HOME=.cache vp run -r test",
    "contracts:generate": "XDG_CACHE_HOME=.cache vp run --filter @openbot/control-service-proto generate && XDG_CACHE_HOME=.cache vp run --filter @openbot/computer-service-proto generate",
    "dev": "vp run --filter @openbot/cli dev",
    "deploy:prod": "vp run --filter @openbot/cli deploy --",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "openbot": "vp run --filter @openbot/cli start --",
    "prepare": "vp config",
    "test": "vp run -r test",
    "test:e2e": "playwright test",
    "typecheck": "XDG_CACHE_HOME=.cache vp run contracts:generate && XDG_CACHE_HOME=.cache vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@ai-sdk/openai": "3.0.94",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.7",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@openbot/agent-provider": "workspace:*",
    "@openbot/agent-service-provider": "workspace:*",
    "@openbot/computer-provider": "workspace:*",
    "@openbot/computer-service-proto": "workspace:*",
    "@openbot/configuration": "workspace:*",
    "@openbot/control-service-proto": "workspace:*",
    "@openbot/control-service-provider": "workspace:*",
    "@openbot/inference-model-provider": "workspace:*",
    "@openbot/runtime-provider": "workspace:*",
    "@openbot/skills-provider": "workspace:*",
    "@openbot/tools-provider": "workspace:*",
    "@playwright/test": "1.55.0",
    "@trytilde/cli": "0.1.0",
    "@trytilde/harness-sdk": "0.1.2",
    "@trytilde/harness-sdk-vercel-ai-node": "0.2.0",
    "@types/node": "24.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vercel/sandbox": "3.0.0",
    "ai": "6.0.250",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vercel": "58.9.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "packageExtensions": {
      "@trytilde/api-client@*": {
        "dependencies": {
          "@types/node": "24.3.0",
          "typescript": "5.9.3",
          "vite": "8.0.16",
          "vite-plugin-dts": "4.5.4"
        }
      }
    }
  }
}
