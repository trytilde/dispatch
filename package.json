{
  "name": "openbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm contracts:generate && XDG_CACHE_HOME=.cache turbo run build && node scripts/stage-web-assets.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check": "pnpm contracts:generate && XDG_CACHE_HOME=.cache turbo run typecheck lint test",
    "contracts:generate": "XDG_CACHE_HOME=.cache pnpm --filter @openbot/contracts generate && XDG_CACHE_HOME=.cache pnpm --filter @openbot/control-service-proto generate",
    "db:migrate": "pnpm --filter @openbot/db migrate",
    "dev": "pnpm --filter @openbot/cli dev",
    "deploy:prod": "pnpm --filter @openbot/cli run deploy --",
    "openbot": "pnpm --filter @openbot/cli start --",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm contracts:generate && XDG_CACHE_HOME=.cache turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.7",
    "@ai-sdk/openai": "3.0.94",
    "@openbot/agent-provider": "workspace:*",
    "@openbot/agent-provider-core": "workspace:*",
    "@openbot/config": "workspace:*",
    "@openbot/control-service-proto": "workspace:*",
    "@openbot/db": "workspace:*",
    "@openbot/inference-model-provider": "workspace:*",
    "@openbot/skills-provider": "workspace:*",
    "@openbot/skills-provider-core": "workspace:*",
    "@openbot/tools-provider": "workspace:*",
    "@openbot/tools-provider-core": "workspace:*",
    "@playwright/test": "1.55.0",
    "@trytilde/cli": "0.1.0",
    "@trytilde/harness-sdk-vercel-ai-node": "0.2.0",
    "@types/node": "24.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vercel/sandbox": "3.0.0",
    "ai": "6.0.250",
    "tsx": "4.20.4",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "vercel": "58.9.4",
    "vitest": "3.2.4",
    "yaml": "2.9.0"
  }
}
