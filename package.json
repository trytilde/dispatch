{
  "name": "@trytilde/dispatch-workspace",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "XDG_CACHE_HOME=.cache vp run contracts:generate && XDG_CACHE_HOME=.cache vp run -r build && pnpm verify:packages && pnpm verify:cli",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check": "XDG_CACHE_HOME=.cache vp run contracts:generate && XDG_CACHE_HOME=.cache vp check",
    "connect": "vp run --filter @trytilde/cli start -- connect --",
    "contracts:generate": "XDG_CACHE_HOME=.cache vp run --filter @trytilde/dispatch-computer-service-proto generate",
    "deploy:prod": "vp run --filter @trytilde/cli deploy --",
    "desktop:package": "vp run --filter @trytilde/cli start -- desktop package",
    "dev": "vp run --filter @trytilde/cli dev",
    "dev:desktop": "vp run --filter @trytilde/cli start -- desktop dev",
    "dev:remote": "vp run --filter @trytilde/cli start -- remote --",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "tilde": "vp run --filter @trytilde/cli start --",
    "publish:tilde-sdk": "vp run --filter @trytilde/cli start -- sdk publish --yes",
    "prepare": "vp config",
    "release:desktop": "vp run --filter @trytilde/cli start -- desktop release --",
    "smoke:tilde-sdk": "vp run --filter @trytilde/cli start -- sdk smoke",
    "test": "vp run -r test",
    "test:e2e": "playwright test",
    "test:tilde-sdk:e2e": "vp run --filter @trytilde/sdk test:e2e",
    "typecheck": "XDG_CACHE_HOME=.cache vp run contracts:generate && XDG_CACHE_HOME=.cache vp check --no-fmt --no-lint",
    "verify:cli": "repository_root=${npm_package_json%/package.json}; cd /tmp && \"$repository_root/cli/dist/index.js\" --help >/dev/null 2>&1",
    "verify:packages": "node scripts/verify-package-artifacts.mjs"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "5.0.27",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.7",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@hey-api/client-fetch": "0.13.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@openai/codex": "0.144.1",
    "@playwright/test": "1.55.0",
    "@trytilde/api-client": "workspace:*",
    "@trytilde/cli": "workspace:*",
    "@trytilde/dispatch-agent-provider": "workspace:*",
    "@trytilde/dispatch-agent-service-provider": "workspace:*",
    "@trytilde/dispatch-auth-provider": "workspace:*",
    "@trytilde/dispatch-client-runtime": "workspace:*",
    "@trytilde/dispatch-computer-service-proto": "workspace:*",
    "@trytilde/dispatch-computer-service-provider": "workspace:*",
    "@trytilde/dispatch-computer-tools": "workspace:*",
    "@trytilde/dispatch-configuration": "workspace:*",
    "@trytilde/dispatch-connector-tools": "workspace:*",
    "@trytilde/dispatch-control-service-provider": "workspace:*",
    "@trytilde/dispatch-git-provider": "workspace:*",
    "@trytilde/dispatch-inference-provider": "workspace:*",
    "@trytilde/dispatch-platform-integrations": "workspace:*",
    "@trytilde/dispatch-runtime-provider": "workspace:*",
    "@trytilde/sdk": "workspace:*",
    "@trytilde/sdk-react": "workspace:*",
    "@trytilde/sdk-vercel-ai-node": "workspace:*",
    "@trytilde/sdk-vercel-ai-react": "workspace:*",
    "@types/node": "24.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vercel/sandbox": "3.0.0",
    "ai": "7.0.64",
    "ai-sdk-provider-codex-cli": "2.1.2",
    "openapi-typescript": "7.10.1",
    "tsdown": "0.22.14",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vercel": "58.9.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.1"
}
