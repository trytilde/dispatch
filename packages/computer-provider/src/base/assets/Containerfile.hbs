# syntax=docker/dockerfile:1

# Build the computer service from the exact source contained in this image
# context. The runtime image must never depend on a host-precompiled bundle.
FROM node:24-bookworm-slim AS computer-service-builder
WORKDIR /source
RUN corepack enable && corepack prepare pnpm@10.33.1 --activate

# Install only the computer service workspace and its transitive dependencies.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/computer-service/package.json apps/computer-service/package.json
COPY packages/computer-service-proto/package.json packages/computer-service-proto/package.json
COPY packages/utilities/package.json packages/utilities/package.json
RUN pnpm install --frozen-lockfile --filter @openbot/computer-service...

# Copy sources after dependency installation so source edits keep that layer hot.
COPY apps/computer-service apps/computer-service
COPY packages/computer-service-proto packages/computer-service-proto
COPY packages/utilities packages/utilities
RUN pnpm --filter @openbot/computer-service build

# Node 24 is both the service runtime and the base for the shared computer image.
FROM node:24-bookworm-slim

COPY packages/computer-provider/src/base/assets/bootstrap.sh /opt/openbot/bootstrap.sh
COPY packages/computer-provider/src/base/assets/development-setup.sh /usr/local/bin/setup-openbot-development
COPY packages/computer-provider/src/base/assets/start.sh /usr/local/bin/start-openbot-computer
COPY --from=computer-service-builder /source/apps/computer-service/dist/index.js /opt/openbot/computer-service.mjs
COPY --from=computer-service-builder /source/apps/computer-service/src/assets /opt/openbot/assets

# Install the desktop stack once while building the shared image.
RUN chmod 0755 /opt/openbot/bootstrap.sh /usr/local/bin/setup-openbot-development /usr/local/bin/start-openbot-computer /opt/openbot/computer-service.mjs \
    && /opt/openbot/bootstrap.sh \
    && corepack enable \
    && corepack prepare pnpm@10.33.1 --activate

ENV DISPLAY=:1 \
    CUA_DRIVER_SOCKET=/tmp/openbot-cua-driver.sock \
    OPENBOT_COMPUTER_SERVICE_PORT=4101 \
    OPENBOT_COMPUTER_WORKSPACE=/workspace

WORKDIR /workspace
