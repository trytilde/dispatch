#!/usr/bin/env bash
set -euo pipefail

# Run one agent command in a private mount namespace. Binding the agent's
# persistent directory over /workspace prevents paths in the shared backing
# volume from exposing another agent's files.
agent_root="$1"
agent_user="$2"
logical_cwd="$3"
shift 3

exec unshare --mount --propagation private --fork -- bash -c '
  set -euo pipefail
  agent_root="$1"
  agent_user="$2"
  logical_cwd="$3"
  shift 3
  mount --bind "$agent_root" /workspace
  mount --make-private /workspace
  cd "$logical_cwd"
  # Start from an empty environment so the service API key and other runtime
  # secrets cannot cross into model-controlled agent processes.
  exec runuser --user "$agent_user" -- env -i \
    HOME=/workspace \
    USER="$agent_user" \
    LOGNAME="$agent_user" \
    LANG=C.UTF-8 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    OPENBOT_COMPUTER_WORKSPACE=/workspace \
    "$@"
' openbot-agent-exec "$agent_root" "$agent_user" "$logical_cwd" "$@"
