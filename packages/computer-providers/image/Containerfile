FROM debian:bookworm-slim

COPY packages/computer-providers/image/bootstrap.sh /opt/openbot/bootstrap.sh
COPY packages/computer-providers/image/start.sh /usr/local/bin/start-openbot-computer
COPY apps/computer-service/dist/index.js /opt/openbot/computer-service.mjs

RUN chmod 0755 /opt/openbot/bootstrap.sh /usr/local/bin/start-openbot-computer /opt/openbot/computer-service.mjs \
    && /opt/openbot/bootstrap.sh

ENV DISPLAY=:1 \
    CUA_DRIVER_SOCKET=/tmp/openbot-cua-driver.sock \
    OPENBOT_COMPUTER_SERVICE_PORT=4101 \
    OPENBOT_COMPUTER_WORKSPACE=/workspace

WORKDIR /workspace
