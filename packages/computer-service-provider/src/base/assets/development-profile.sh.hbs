#!/usr/bin/env bash

# Dispatch trusted development sandbox environment.
dispatch_source_root="${DISPATCH_SOURCE_ROOT:-/workspace/dispatch}"
dispatch_age_key_file="${DISPATCH_AGE_KEY_FILE:-/workspace/.dispatch/development/sops-age-key.txt}"

if [[ -r "$dispatch_source_root/configuration/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$dispatch_source_root/configuration/.env"
  set +a
fi

if [[ -r "$dispatch_age_key_file" && -r "$dispatch_source_root/configuration/secrets.enc.yaml" ]]; then
  export SOPS_AGE_KEY_FILE="$dispatch_age_key_file"
  eval "$(
    sops decrypt --output-type json "$dispatch_source_root/configuration/secrets.enc.yaml" \
      | jq -r 'to_entries[] | select(.key != "SECRETS_SOPS_AGE_KEY") | "export \(.key)=\(.value.value | @sh)"'
  )"
fi

unset dispatch_source_root dispatch_age_key_file
