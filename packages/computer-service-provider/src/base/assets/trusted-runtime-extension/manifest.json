{
  "manifest_version": 3,
  "name": "Tilde Trusted Browser Runtime",
  "version": "0.1.0",
  "description": "Trusted runtime for Tilde-managed Browserbase sessions.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
