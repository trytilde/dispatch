{
  "name": "@tryopenbot/configuration",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.package.config.ts && node ../../scripts/copy-package-assets.mjs",
    "lint": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tryopenbot/agent-provider": "workspace:*",
    "@tryopenbot/computer-provider": "workspace:*",
    "@tryopenbot/inference-model-provider": "workspace:*",
    "@tryopenbot/runtime-provider": "workspace:*",
    "@tryopenbot/skills-provider": "workspace:*",
    "@tryopenbot/tools-provider": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
