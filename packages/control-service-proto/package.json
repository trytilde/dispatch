{
  "name": "@openbot/control-service-proto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./gen/*": "./src/gen/*.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "generate": "BUF_CACHE_DIR=../../.cache/buf buf generate",
    "lint": "BUF_CACHE_DIR=../../.cache/buf buf lint",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.7.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.57.2",
    "@bufbuild/protoc-gen-es": "2.7.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
