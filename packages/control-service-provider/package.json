{
  "name": "@tryopenbot/control-service-provider",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsgo --noEmit && tsdown --config ../../tsdown.package.config.ts && node ../../scripts/copy-package-assets.mjs",
    "lint": "tsgo --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@tryopenbot/runtime-provider": "workspace:*",
    "@tryopenbot/utilities": "workspace:*",
    "tsdown": "0.22.14",
    "vercel": "58.9.4"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
