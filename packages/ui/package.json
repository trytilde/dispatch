{
  "name": "@tryopenbot/ui",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./beautiful-ui.css": {
      "development": "./src/beautiful-ui/upstream/globals.css",
      "default": "./dist/beautiful-ui/upstream/globals.css"
    },
    "./beautiful-ui/*": {
      "types": "./src/beautiful-ui/upstream/*.tsx",
      "development": "./src/beautiful-ui/upstream/*.tsx",
      "import": "./dist/beautiful-ui/upstream/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./beautiful-ui.css": "./dist/beautiful-ui/upstream/globals.css",
      "./beautiful-ui/*": {
        "types": "./dist/beautiful-ui/upstream/*.d.ts",
        "import": "./dist/beautiful-ui/upstream/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown --config ../../tsdown.package.config.ts && node ../../scripts/copy-package-assets.mjs",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.1.2"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
