{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vp run build",
  "devCommand": "vp -C apps/web dev --host 127.0.0.1 --port $PORT",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "server.ts": {
      "maxDuration": 300,
      "includeFiles": "{apps/server/dist,apps/web/dist}/**/*"
    }
  }
}
